<?xml version="1.0" encoding="utf-8"?>
<mujoco model="hexapod tethered flat">
    <include file="hexapod_tethered_common.xml" />

    <actuator>
        <!-- Flat training intentionally makes the tether effectively force-free. -->
        <general name="cable" tendon="cable" ctrllimited="true" ctrlrange="0 2"
                 forcelimited="true" forcerange="-0.0001 0" gainprm="-200"
                 biasprm="0" />
    </actuator>
</mujoco>
